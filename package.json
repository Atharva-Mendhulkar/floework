{
  "name": "floework",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@opentelemetry/api": "^1.9.1",
    "@supabase/supabase-js": "^2.45.4",
    "@upstash/redis": "^1.38.0",
    "kafkajs": "^2.2.4",
    "lru-cache": "^11.3.6",
