# ==============================================================================
# Floework Environment Configuration (AWS Production Stack)
# ==============================================================================

# Application & Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
AWS_REGION=us-east-1

# Amazon RDS PostgreSQL 16
DB_HOST=floework-staging-postgres.c123456789.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=floework
DB_USER=floework_admin
DB_PASSWORD=your-rds-master-password

# Amazon ElastiCache Redis
REDIS_HOST=floework-staging-redis.xxxxxx.0001.use1.cache.amazonaws.com
REDIS_PORT=6379

# Amazon Cognito Authentication
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=exampleclientid
JWT_SECRET=your-development-jwt-secret-min-32-chars

# Amazon S3 Object Storage & CloudFront
S3_STORAGE_BUCKET=floework-staging-storage-us-east-1
CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net

# Amazon SQS FIFO Queues
SQS_FOCUS_COMPLETION_URL=https://sqs.us-east-1.amazonaws.com/123456789012/floework-staging-focus-completion.fifo
SQS_AUDIT_LOGS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/floework-staging-audit-logs.fifo
SQS_NOTIFICATIONS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/floework-staging-notifications.fifo

# Amazon Bedrock AI
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Amazon SES Transactional Messaging
SES_SENDER_EMAIL=notifications@floework.internal
