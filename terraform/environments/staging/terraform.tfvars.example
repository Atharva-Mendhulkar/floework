# ==============================================================================
# Floework Staging Environment Variables (Example)
# Copy this file to terraform.tfvars and fill in your confidential values
# ==============================================================================

aws_region  = "us-east-1"
environment = "staging"
project_name = "floework"

# Networking Configuration
vpc_cidr                  = "10.0.0.0/16"
availability_zones        = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs       = ["10.0.1.0/24", "10.0.2.0/24"]
private_app_subnet_cidrs  = ["10.0.10.0/24", "10.0.11.0/24"]
private_data_subnet_cidrs = ["10.0.20.0/24", "10.0.21.0/24"]
enable_multi_az_nat       = false # false for single NAT (cost optimization for staging)

# Application Secrets (Stored in SSM Parameter Store with KMS encryption)
supabase_url              = "https://vlozimkyxyyigclfdntp.supabase.co"
supabase_anon_key         = "sb_publishable_..."
supabase_service_role_key = "sb_secret_..."
gemini_api_key            = "AIzaSy..."
jwt_secret                = "your-256-bit-secret-here"
upstash_redis_rest_url    = "https://your-redis.upstash.io"
upstash_redis_rest_token  = "your-upstash-token"

# Tags
tags = {
  Project     = "floework"
  Environment = "staging"
  ManagedBy   = "terraform"
}
