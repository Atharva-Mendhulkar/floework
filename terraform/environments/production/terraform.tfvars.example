# ==============================================================================
# Floework Production Environment Variables Template
# Copy to terraform.tfvars and populate with production values before apply.
# ==============================================================================

aws_region  = "us-east-1"
project_name = "floework"
environment  = "production"

# Ingress & Custom Domain
enable_custom_domain = true
custom_domain_name   = "floework.com"
enable_ses_domain    = true

# High Availability Multi-AZ Networking
enable_multi_az_nat = true
vpc_cidr            = "10.1.0.0/16"

# Production Compute & Autoscaling
container_image   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/floework-api:production"
ecs_desired_count = 2
ecs_cpu           = 512
ecs_memory        = 1024

# Production Database (RDS PostgreSQL 16 Multi-AZ)
db_instance_class          = "db.t4g.medium"
db_multi_az                = true
db_allocated_storage       = 50
db_max_allocated_storage   = 200
db_backup_retention_period = 30
db_deletion_protection     = true
db_skip_final_snapshot     = false

# Production Cache (ElastiCache Redis HA Cluster)
redis_node_type          = "cache.t4g.small"
redis_num_cache_clusters = 2

# AWS WAF v2
waf_rate_limit_per_5m = 1000

# CI/CD OIDC Integration
enable_ci_cd_oidc = true
github_repo       = "Atharva-Mendhulkar/floework"

# Amazon Bedrock
bedrock_region   = "us-east-1"
bedrock_model_id = "anthropic.claude-3-haiku-20240307-v1:0"

# Resource Tags
tags = {
  Project     = "floework"
  Environment = "production"
  ManagedBy   = "terraform"
}
